{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["tscircuit"]
  },
  "include": ["index.circuit.tsx", "lib/**/*.tsx", "circuit/**/*.tsx", "scratch/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
